{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curated.vitals_1m.v1",
  "title": "1-minute vital-sign window per encounter",
  "description": "Event-time tumbling window (1 min) over vital_observations, with a simplified NEWS2-style early-warning score. Emitted once per window when the watermark passes window_end (5 s allowed lateness). Producer: flink/jobs/vitals_1m.sql. NOT FOR CLINICAL USE.",
  "x-topic": "curated.vitals_1m.v1",
  "x-key": ["tenant_id", "encounter_id", "window_start"],
  "x-semantics": "upsert",
  "x-freshness-slo": "window visible in ClickHouse < 30 s after window_end",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id", "encounter_id", "patient_id", "window_start", "window_end", "sample_count",
    "avg_heart_rate", "avg_resp_rate", "avg_spo2", "avg_systolic_bp", "avg_temperature_c",
    "min_spo2", "max_heart_rate", "news2_score", "risk_level"
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(\\.\\d{1,9})?$"
    }
  },
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "encounter_id": { "type": "integer" },
    "patient_id": { "type": "integer" },
    "window_start": { "$ref": "#/$defs/timestamp" },
    "window_end": { "$ref": "#/$defs/timestamp" },
    "sample_count": { "type": "integer", "minimum": 1 },
    "avg_heart_rate": { "type": "number", "minimum": 0, "maximum": 300 },
    "avg_resp_rate": { "type": "number", "minimum": 0, "maximum": 80 },
    "avg_spo2": { "type": "number", "minimum": 0, "maximum": 100 },
    "avg_systolic_bp": { "type": "number", "minimum": 0, "maximum": 300 },
    "avg_temperature_c": { "type": "number", "minimum": 25, "maximum": 45 },
    "min_spo2": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_heart_rate": { "type": "integer", "minimum": 0, "maximum": 300 },
    "news2_score": { "type": "integer", "minimum": 0, "maximum": 15 },
    "risk_level": { "enum": ["low", "medium", "high"] }
  }
}
