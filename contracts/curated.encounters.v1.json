{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curated.encounters.v1",
  "title": "Curated encounter (latest state)",
  "description": "One record per encounter; the latest record per key wins. Tombstones (null value) mean the key was retracted. Producer: flink/jobs/encounters_curated.sql. Owner: data platform.",
  "x-topic": "curated.encounters.v1",
  "x-key": ["tenant_id", "encounter_id"],
  "x-semantics": "upsert",
  "x-freshness-slo": "p95 source-commit to ClickHouse-visible < 15 s",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "encounter_id", "patient_id", "encounter_type", "status", "ward", "admitted_at", "updated_at"],
  "$defs": {
    "timestamp": {
      "type": "string",
      "description": "UTC, 'YYYY-MM-DD HH:MM:SS[.fff]'",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(\\.\\d{1,9})?$"
    }
  },
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "encounter_id": { "type": "integer" },
    "patient_id": { "type": "integer" },
    "encounter_type": { "enum": ["inpatient", "emergency", "observation"] },
    "status": { "enum": ["admitted", "discharged"] },
    "ward": { "type": "string" },
    "admitted_at": { "$ref": "#/$defs/timestamp" },
    "discharged_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "sex": { "enum": ["F", "M", "U", null], "description": "Null while the patient record has not yet been joined." },
    "age_band": { "enum": ["0-17", "18-39", "40-64", "65+", null] },
    "length_of_stay_hours": { "type": ["number", "null"], "minimum": 0 }
  }
}
